# =============================================================================
# Dat.ia - variables de la instalacion on-prem.
#
# `setup.sh` copia este archivo a .env y reemplaza los CHANGE_ME por secretos
# aleatorios. No edite .env a mano salvo que sepa lo que hace: FERNET_KEY no es
# rotable sin recifrar las credenciales de los conectores.
# =============================================================================

# Nombre del proyecto compose. Cambielo si instala dos Dat.ia en el mismo host.
COMPOSE_PROJECT_NAME=datia

# Imagenes del release. El bundle las fija al tag de la version; tambien puede
# usar un digest inmutable:
#   DATIA_BACKEND_IMAGE=ghcr.io/kintsukuro1/datia-backend@sha256:...
# Si los paquetes de GHCR son privados, haga `docker login ghcr.io` antes.
DATIA_BACKEND_IMAGE=ghcr.io/kintsukuro1/datia-backend:latest
DATIA_FRONTEND_IMAGE=ghcr.io/kintsukuro1/datia-frontend:latest

# Air-gapped: 1 omite `docker compose pull` y usa las imagenes ya cargadas con
# `docker load`. Deje 0 en una instalacion con acceso al registry.
DATIA_SKIP_PULL=0

# Secretos de la aplicacion. setup.sh los genera.
# SECRET_KEY: firma los JWT. Cambiarla cierra todas las sesiones.
SECRET_KEY=CHANGE_ME_SECRET_KEY
# FERNET_KEY: cifra las credenciales de los conectores. Si se pierde o cambia,
# las credenciales guardadas dejan de descifrarse y hay que volver a cargarlas.
FERNET_KEY=CHANGE_ME_FERNET_KEY

# Metadata corporativa (PostgreSQL). No se publica al host.
POSTGRES_USER=datia
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=democratizacion_metadatos

# -----------------------------------------------------------------------------
# Motor LLM
# -----------------------------------------------------------------------------
# central  -> usa el servicio `ollama` de este compose.
# external -> usa un endpoint administrado por la empresa (OLLAMA_BASE_URL).
# user     -> la empresa habilita que cada usuario apunte su propio LLM en su
#             red privada. El backend valida la URL (loopback, RFC1918,
#             host.docker.internal); el resto da 400.
# En central/external, la URL y el modelo que mande el navegador se ignoran.
LLM_MODE=central
LLM_PROVIDER=ollama

# Dentro del compose, el servicio se llama `ollama`. Si usa un Ollama en el
# host, fuera de este compose: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=1
# Motor administrado cuando LLM_PROVIDER=openai_compatible o custom (vLLM,
# LM Studio, gateway corporativo). Con LLM_PROVIDER=ollama se usa OLLAMA_BASE_URL.
# El nombre del modelo se toma de OLLAMA_MODEL en todos los casos: ponga ahi el
# id que espera ese servidor (por ejemplo el de vLLM o el de LM Studio).
OPENAI_COMPATIBLE_URL=http://localhost:1234/v1
LLM_NUM_CTX=32768

# La ventana de contexto real la fija el servidor al arrancar, no esta variable
# por request. Para Ollama, el modelo se configura en su propio Modelfile.

# -----------------------------------------------------------------------------
# Red y TLS
# -----------------------------------------------------------------------------
# Interfaz del host donde se publica el frontend. 127.0.0.1 = solo esta maquina;
# use 0.0.0.0 solo si un LB/ingress de confianza lo alcanza por la LAN.
DATIA_BIND_IP=127.0.0.1
DATIA_HTTP_PORT=8080

# CIDR del proxy que pone X-Forwarded-For. El default es la subred `edge` del
# compose (Caddy o un LB conectado a esa red). Si el LB es externo, ponga su
# CIDR real; si publica el frontend directo sin proxy, deje 127.0.0.1.
# Para varios CIDR, nginx necesita una linea set_real_ip_from por cada uno:
# este bundle soporta uno. Use el rango que cubra a todos los proxies.
TRUSTED_PROXY_CIDR=172.30.0.0/24

# Perfil caddy: dominio que resuelve a esta VM. Caddy gestiona el certificado
# con ACME. Si usa su propio LB/ingress, no active el perfil y deje esto vacio
# o comentado.
#DATIA_DOMAIN=datia.empresa.com
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Para habilitar Caddy en `docker compose up` sin pasar --profile:
#COMPOSE_PROFILES=caddy

# Origenes permitidos por CORS. El SPA va por el mismo origen, asi que en el
# layout normal no se ejerce. Si publica la API en otro dominio, agreguelo.
CORS_ORIGINS=["http://localhost:8080"]

# Dias que vale una clave temporal creada por un admin. La cuenta debe cambiarla
# en el primer login.
TEMP_PASSWORD_TTL_DAYS=7

# /docs y OpenAPI no piden autenticacion. En una instalacion real van apagados.
ENABLE_API_DOCS=false

# -----------------------------------------------------------------------------
# Primer administrador (solo lo usa setup.sh)
# -----------------------------------------------------------------------------
# Si no define DATIA_ADMIN_PASSWORD, setup.sh genera una y la imprime una vez.
# La cuenta nace con must_change_password=True: se cambia en el primer login.
DATIA_ADMIN_USERNAME=admin
#DATIA_ADMIN_EMAIL=admin@empresa.com
#DATIA_ADMIN_PASSWORD=

# setup.sh descarga OLLAMA_MODEL automaticamente. En una instalacion air-gapped
# ponga 1 y cargue el modelo por fuera (ollama create / volumen importado).
#DATIA_SKIP_MODEL_PULL=1
