# ==============================================================================
# DATIA - CONFIGURACIÓN DE ENTORNO LOCAL
# ==============================================================================

# Configuración del Servidor Backend
HOST=127.0.0.1
PORT=8000

# URL de la API que usa el frontend en el navegador.
#
# 127.0.0.1 y NO localhost, a propósito. `localhost` resuelve primero a `::1`
# (IPv6) y el backend de arriba escucha SOLO en IPv4, así que el fetch del
# navegador recibe `TypeError: Failed to fetch` — sin código HTTP, porque la
# petición nunca llegó al servidor. curl sí hace fallback al IPv4, y por eso
# probarlo por terminal lo daba por bueno.
#
# Esto aplica a `npm run dev` (frontend en 5173, backend en 8000). La imagen
# Docker construida por el Dockerfile de este repo NO usa este valor: su build
# fija VITE_API_BASE_URL=/api/v1 y nginx proxya /api/ al backend, así que el
# navegador habla con el mismo origen.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Firma de tokens JWT.
#
# Este valor es el DEFAULT de desarrollo y main.py:validate_startup_security
# RECHAZA el arranque cuando ENVIRONMENT=production y la clave sigue siendo
# esta. En producción hay que cambiarla por una única y aleatoria.
SECRET_KEY=democratizacion_datos_super_secret_key_local_2026_aes256_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Modo: development | production
#
# En production, main.py REQUIERE un SECRET_KEY propio (el de arriba lo rechaza)
# y avisa por stderr si CORS_ORIGINS sigue siendo '*'.
ENVIRONMENT=development

# Siembra demo al arrancar: usuarios con clave conocida (admin/admin123 y las
# demas del README), la base de negocio de demostracion, su conector y la
# matriz de permisos que la sustenta. Sin valor explicito queda encendida en
# development y apagada en production: en una instalacion real seria dejar
# cuentas activas con las claves publicadas. Ponlo en true SOLO en maquinas de
# demostracion.
DEMO_MODE=false

# Modo demo del frontend: decide si el desplegable de perfiles demo entra al
# bundle en build-time (`npm run build` / imagen Docker). Las credenciales de
# esos perfiles solo existen en el bundle si esto es true. En una instalacion
# real y aca: false.
VITE_DEMO_MODE=false

# Orígenes del frontend que pueden llamar a la API. La autenticación viaja en el
# header Authorization (no en cookies), así que el backend usa
# `allow_credentials=False`; con '*' el middleware no refleja credenciales, pero
# cualquier sitio puede hacer peticiones con un token que conozca. En producción
# es un warning de arranque, no un fallo. Pon las URLs reales:
#   CORS_ORIGINS=["http://localhost:5173"]
# Con el compose principal de este repo, frontend y API comparten origen, así
# que CORS no interviene.
CORS_ORIGINS=["*"]

# Días de validez de la contraseña temporal de una cuenta creada por un
# administrador. El cambio se exige en el primer login; si no se hace dentro
# del plazo, la clave vence y solo quedan accesibles /auth/me,
# /auth/change-password y /auth/logout.
TEMP_PASSWORD_TTL_DAYS=7

# Publica /docs y /api/v1/openapi.json (los 50 endpoints, sin autenticación).
# Sin valor explícito: apagado en production, encendido en development. Ponlo en
# true si trabajas contra un .env que dice production y quieres Swagger:
#   ENABLE_API_DOCS=true
#ENABLE_API_DOCS=

# Cifrado de credenciales de conectores (columnas encrypted_*).
# docker-compose.yml la exige (`:?`), así que sin esta variable `docker compose up`
# se niega a arrancar. Generar una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# No se puede rotar sin volver a cifrar: cambiarla deja las credenciales ya
# guardadas indescifrables, y eso solo se ve a mitad de una consulta.
FERNET_KEY=

# Configuración de IA Local (Ollama / LM-Studio / llama.cpp)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OPENAI_COMPATIBLE_URL=http://localhost:1234/v1

# Política del motor LLM (instalación on-prem de una sola empresa):
#   central  -> la empresa administra el motor. La URL/modelo de Ajustes del
#               cliente se IGNORA; se usa OLLAMA_BASE_URL/LLM_PROVIDER.
#   external -> igual que central, pero el motor está fuera del compose
#               (otro contenedor del host, otra máquina de la LAN o un gateway).
#   user     -> la empresa habilita que cada usuario apunte su propio LLM. La
#               URL se valida antes de usarla: loopback, host.docker.internal o
#               RFC1918; IPs públicas, link-local y hostnames internos dan 400.
# Sin valor explícito: user en development y central en production.
#LLM_MODE=central

# Enriquecimiento del catálogo con IA (opcional; los defaults ya sirven).
# El modelo se llama por lotes de columnas y el tamaño efectivo del lote baja
# solo con la velocidad medida del modelo; estos son el techo y los fences.
# Subirlos en máquinas con GPU acelera las tablas anchas.
# LLM_ENRICH_COLUMNS_PER_CALL=6
# LLM_ENRICH_TABLE_TIMEOUT_S=120
# LLM_ENRICH_TOTAL_BUDGET_S=360

# Configuración PostgreSQL Opcional (Modo Empresarial)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=democratizacion_metadatos
